{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xitij27/backlith/blob/main/schemas/schedule-v1.json",
  "title": "Backlith schedule, version 1",
  "description": "A timetable for Backlith's calendar. Repeating events use days, from and until; one-off events use date.",
  "type": "object",
  "additionalProperties": false,
  "required": ["backlith", "name", "events"],
  "properties": {
    "backlith": { "const": 1, "description": "The format version. Always 1." },
    "name": { "type": "string", "minLength": 1, "description": "The calendar's name." },
    "timezone": { "type": "string", "minLength": 1, "description": "The IANA time zone the times are in, such as Europe/Berlin. Defaults to the computer's zone." },
    "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/event" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD" },
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "description": "24-hour HH:MM" },
    "day": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] },
    "skip": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(/\\d{4}-\\d{2}-\\d{2})?$", "description": "A date, or a range of dates FROM/TO, both included." },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "location": { "type": "string" },
        "notes": { "type": "string" },
        "date": { "$ref": "#/$defs/date", "description": "The day of a one-off event." },
        "days": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/day" }, "description": "The weekdays a repeating event happens on." },
        "from": { "$ref": "#/$defs/date", "description": "The first day a repeating event can happen." },
        "until": { "$ref": "#/$defs/date", "description": "The last day a repeating event can happen." },
        "every": { "type": "integer", "minimum": 1, "description": "Weeks between repeats. 2 means every other week. Defaults to 1." },
        "skip": { "type": "array", "items": { "$ref": "#/$defs/skip" }, "description": "Dates or date ranges when a repeating event does not happen." },
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time", "description": "Must be after start. An event past midnight is written as two events." },
        "allDay": { "type": "boolean" }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": ["date"],
              "not": { "anyOf": [{ "required": ["days"] }, { "required": ["from"] }, { "required": ["until"] }, { "required": ["every"] }, { "required": ["skip"] }] }
            },
            {
              "required": ["days", "from", "until"],
              "not": { "required": ["date"] }
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": ["allDay"],
              "properties": { "allDay": { "const": true } },
              "not": { "anyOf": [{ "required": ["start"] }, { "required": ["end"] }] }
            },
            {
              "required": ["start", "end"],
              "properties": { "allDay": { "const": false } }
            }
          ]
        }
      ]
    }
  }
}
